# Use mock until a vetted provider is configured.
DEFAULT_PROVIDER=mock
DEFAULT_MODEL=mock-legal-model

# Restrict browser callers in production. For the nginx path below, same-origin works.
CORS_ORIGINS=https://app.nonsoft.com

# Provider credentials stay server-side only. Enable exactly the one you use.
# DEEPSEEK_API_KEY=
# KIMI_API_KEY=
# GLM_API_KEY=
# MINIMAX_API_KEY=
# GROK_API_KEY=
# MIMO_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://host.docker.internal:11434
